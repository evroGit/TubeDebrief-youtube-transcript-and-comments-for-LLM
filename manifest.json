{
  "manifest_version": 3,
  "name": "TubeDebrief — YouTube video + comments as one prompt for your LLM",
  "version": "1.0.0",
  "description": "Собирает транскрипт и комментарии YouTube-видео в один prompt для ChatGPT, Claude, Gemini, Perplexity и DeepSeek.",
  "permissions": ["storage", "activeTab", "scripting", "offscreen", "clipboardWrite"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TubeDebrief"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": [
        "core/i18n.js",
        "core/storage.js",
        "core/filter.js",
        "core/targets.js",
        "core/promptBuilder.js",
        "core/clipboard.js",
        "core/commentCollector.js",
        "core/transcriptCollector.js",
        "core/openTarget.js",
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content/autopaste.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
